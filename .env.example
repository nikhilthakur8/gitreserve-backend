# ── Server ──────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017/gitreserve

# ── Auth (JWT) ──────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=86400

# ── Webhooks ────────────────────────────────────────────
WEBHOOK_BASE_URL=http://localhost:3000

# ── GitHub OAuth ────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/integrations/oauth/github/callback

# ── GitLab OAuth ────────────────────────────────────────
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:3000/api/v1/integrations/oauth/gitlab/callback

# ── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── GitHub OAuth (Login) ────────────────────────────────
GITHUB_AUTH_CLIENT_ID=
GITHUB_AUTH_CLIENT_SECRET=
GITHUB_AUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/github/callback

# ── Google OAuth (Login) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback

# ── AWS / S3 / R2 ────────────────────────���─────────────
AWS_REGION=us-east-1

# ── SQS ─────────────────────────────────────────────────
SQS_QUEUE_URL=
SQS_ENDPOINT=

# ── Consumer ────────────────────────────────────────────
CONSUMER_CONCURRENCY=5
