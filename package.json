{
  "name": "gitreserve-backend",
  "version": "0.1.0",
  "description": "Self-hosted Git repository management backend with S3/R2 storage and cross-platform migration engine",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/bootstrap/api/index.ts",
    "dev:consumer": "tsx watch src/bootstrap/consumer/index.ts",
    "build": "esbuild src/bootstrap/api/index.ts --bundle --platform=node --format=esm --outfile=dist/api.js --packages=external --sourcemap",
    "build:consumer": "esbuild src/bootstrap/consumer/index.ts --bundle --platform=node --format=esm --outfile=dist/consumer.js --packages=external --sourcemap",
    "start": "node dist/api.js",
    "start:consumer": "node dist/consumer.js",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "git",
    "repository",
    "s3",
    "r2",
    "migration",
    "github",
    "gitlab",
    "bitbucket"
  ],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.9",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/client-sqs": "^3.1048.0",
    "@aws-sdk/lib-storage": "^3.1045.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "nanoid": "^3.3.12",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
